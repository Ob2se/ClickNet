/Plugins/SteamGNSPlugin/Binaries/ThirdParty/SteamGNSPluginLibrary/*
!/Plugins/SteamGNSPlugin/Binaries/ThirdParty/SteamGNSPluginLibrary/Win64/
/Plugins/SteamGNSPlugin/Binaries/ThirdParty/SteamGNSPluginLibrary/Win64/*
!/Plugins/SteamGNSPlugin/Binaries/ThirdParty/SteamGNSPluginLibrary/Win64/ExampleLibrary.dll

